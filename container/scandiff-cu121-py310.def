Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%labels
    org.activevision.component "scandiff-worker"
    org.activevision.python "3.10"
    org.activevision.pytorch "2.3.1+cu121"
    org.activevision.scandiff.commit "9eff26cf2df140c09b868e7351f02d3797a37d1f"

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONUNBUFFERED=1

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential git python3 python3-dev python3-pip
    rm -rf /var/lib/apt/lists/*
    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel
    python3 -m pip install --no-cache-dir \
        torch==2.3.1 torchvision==0.18.1 \
        --index-url https://download.pytorch.org/whl/cu121
    # The upstream full requirements include training/evaluation-only packages,
    # including MultiScaleDeformableAttention==1.0, which has no public wheel.
    # These are the pinned packages imported by demo.py and the AVRW worker.
    python3 -m pip install --no-cache-dir \
        hydra-core==1.3.2 numpy==1.26.3 pillow==10.2.0 timm==1.0.9

%test
    python3 -c "import hydra, numpy, timm, torch; assert torch.__version__.startswith('2.3.1')"
